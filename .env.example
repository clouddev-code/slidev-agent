# Tavily API Key (required for web search)
# Get your API key at: https://app.tavily.com/
TAVILY_API_KEY=tvly-your_api_key_here

# Model Provider: 'anthropic' (default), 'bedrock' or 'vertexai'
MODEL_PROVIDER=anthropic

# --- Claude Platform (Claude API) Configuration ---
ANTHROPIC_MODEL_ID=claude-sonnet-5-5
# Local dev: API key. On AgentCore Runtime the CDK stack sets the WIF IDs
# below instead (no API key needed).
ANTHROPIC_API_KEY=sk-ant-your_api_key_here
# ANTHROPIC_FEDERATION_RULE_ID=fdrl_...
# ANTHROPIC_ORGANIZATION_ID=...
# ANTHROPIC_SERVICE_ACCOUNT_ID=svac_...
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# --- Bedrock Configuration ---
AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=us.anthropic.claude-opus-4-6-v1:0

# --- Vertex AI Configuration ---
# GEMINI_MODEL_ID=gemini-3.1-pro-preview
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_GENAI_USE_VERTEXAI=true
