# Backend (AG-UI / FastAPI) URL
AGENT_URL=http://localhost:8000/

# Skip Cognito login for local development. On Lambda the stack sets
# COGNITO_USER_POOL_ID / COGNITO_DOMAIN_URL / COGNITO_CLIENT_ID_PARAM and
# AGENT_RUNTIME_ARN instead.
AUTH_DISABLED=true

# Slidev dev server URL, embedded as the live preview panel
NEXT_PUBLIC_SLIDEV_URL=http://localhost:3030
